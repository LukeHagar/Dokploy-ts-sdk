# dokploy SDK Environment Variables
# Copy this file to .env and fill in your actual values
# DO NOT commit the .env file to version control

# Security Configuration
# The SDK supports loading security credentials from environment variables
# with the prefix: DOKPLOY_
#
# Security environment variables:
DOKPLOY_AUTHORIZATION=your_authorization_here

# Debug Configuration
# Enable HTTP request/response logging for debugging
DOKPLOY_DEBUG=true
